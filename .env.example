POSTGRES_PASSWORD="replace-with-a-random-password"
DATABASE_URL="postgresql://postgres:replace-with-a-random-password@127.0.0.1:5432/postgres"
BROWSER_TOKEN="replace-with-a-random-token"
BROWSER_URL="ws://127.0.0.1:30000/chromium"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=3000
CHATGPT_MODEL=gpt-6-luna
# Crea la sesión OAuth con: cargo run --example chatgpt_login
# Por defecto: $HOME/.config/wodbuster-jueces/auth.json
# CHATGPT_AUTH_FILE=/ruta/privada/auth.json
